{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oteyami2001/Internal-Developer-Platform-CI-CD-Automation/platform/schemas/service.schema.json",
  "title": "IDP Service Manifest",
  "description": "Developer-owned description of a service. It can only express choices the platform has pre-approved: there are no fields for IAM, security groups, CIDRs, regions, VPCs or arbitrary AWS resources. Unknown fields are rejected everywhere (additionalProperties: false). Cross-field and environment-specific rules live in platform/policy/platform-policy.yaml and are enforced by scripts/validate_service.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "idp.platform/v1alpha1" },
    "kind": { "const": "Service" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "owner", "description"],
      "properties": {
        "name": {
          "description": "DNS-safe service name. Max 20 characters so '<project>-<env>-<name>' fits AWS's 32-character target-group and load-balancer name limits.",
          "type": "string",
          "pattern": "^[a-z](?!.*--)[a-z0-9-]{1,18}[a-z0-9]$"
        },
        "owner": {
          "description": "Owning team; must be listed in the platform policy's approved teams.",
          "type": "string",
          "pattern": "^team-[a-z0-9-]{2,30}$"
        },
        "description": { "type": "string", "minLength": 10, "maxLength": 200 },
        "tier": { "enum": ["experimental", "standard", "critical"], "default": "standard" },
        "repository": {
          "description": "Path of the service inside this repository (defaults to apps/<name>).",
          "type": "string",
          "pattern": "^apps/[a-z0-9-]+$"
        },
        "tags": {
          "description": "Extra cost-allocation tags. Platform tags (Project, Environment, Service, Owner, ManagedBy) are set by the platform and cannot be overridden.",
          "type": "object",
          "maxProperties": 10,
          "propertyNames": { "pattern": "^[a-z][a-z0-9-]{1,31}$" },
          "additionalProperties": { "type": "string", "pattern": "^[A-Za-z0-9 ._:/=+@-]{1,128}$" }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "container", "environments"],
      "properties": {
        "runtime": { "enum": ["python3.13"] },
        "container": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port"],
          "properties": {
            "port": {
              "description": "Port the container listens on. Unprivileged ports only (the container runs as non-root).",
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535
            },
            "cpu": { "description": "Fargate CPU units.", "enum": [256, 512, 1024], "default": 256 },
            "memory": { "description": "Fargate memory (MiB).", "enum": [512, 1024, 2048, 3072, 4096], "default": 512 }
          },
          "allOf": [
            {
              "description": "Valid Fargate CPU/memory combinations (subset approved by the platform).",
              "if": { "properties": { "cpu": { "const": 256 } } },
              "then": { "properties": { "memory": { "enum": [512, 1024, 2048] } } }
            },
            {
              "if": { "properties": { "cpu": { "const": 512 } }, "required": ["cpu"] },
              "then": { "properties": { "memory": { "enum": [1024, 2048, 3072, 4096] } }, "required": ["memory"] }
            },
            {
              "if": { "properties": { "cpu": { "const": 1024 } }, "required": ["cpu"] },
              "then": { "properties": { "memory": { "enum": [2048, 3072, 4096] } }, "required": ["memory"] }
            }
          ]
        },
        "healthCheck": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string", "pattern": "^/[a-z0-9/_-]{0,63}$", "default": "/health" },
            "intervalSeconds": { "type": "integer", "minimum": 10, "maximum": 60, "default": 30 },
            "healthyThreshold": { "type": "integer", "minimum": 2, "maximum": 5, "default": 2 },
            "unhealthyThreshold": { "type": "integer", "minimum": 2, "maximum": 5, "default": 3 }
          }
        },
        "deployment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "strategy": {
              "description": "MVP supports ECS rolling updates only. Blue/green is a planned extension.",
              "enum": ["rolling"],
              "default": "rolling"
            },
            "circuitBreakerRollback": {
              "description": "ECS deployment circuit breaker with automatic rollback to the last healthy task definition.",
              "type": "boolean",
              "default": true
            },
            "minimumHealthyPercent": { "type": "integer", "minimum": 0, "maximum": 100, "default": 100 },
            "maximumPercent": { "type": "integer", "minimum": 100, "maximum": 200, "default": 200 }
          }
        },
        "environments": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "propertyNames": { "enum": ["dev", "staging", "prod"] },
          "patternProperties": {
            "^(dev|staging|prod)$": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled"],
              "properties": {
                "enabled": { "type": "boolean" },
                "desiredCount": { "type": "integer", "minimum": 0, "maximum": 6, "default": 1 }
              }
            }
          }
        },
        "environmentVariables": {
          "description": "Plain, NON-secret configuration. Secrets go in spec.secrets.",
          "type": "object",
          "maxProperties": 25,
          "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
          "additionalProperties": { "type": "string", "maxLength": 256 }
        },
        "secrets": {
          "description": "Secrets injected from AWS Secrets Manager at task start. Only a short name is accepted; the platform maps it to idp/<env>/<service>/<secretName>, so a service can never reference another service's secrets or an arbitrary ARN.",
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "secretName"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
              "secretName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" }
            }
          }
        }
      }
    }
  }
}
